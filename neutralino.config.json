{
  "applicationId": "com.study.crabclaw",
  "applicationName": "crabclaw",
  "version": "2.0.0",
   "author": "crabclaw",
  "description": "crabclaw",
  "copyright": "Copyright (c) 2024 crabclaw",
  "defaultMode": "window",
  "port": 0,
  "enableServer": true,
  "enableNativeAPI": true,
  "documentRoot": "/resources/",
  "url": "/",
  "cli": {
    "binaryName": "crabclaw",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/neutralino.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0",
    "distributionPath": "/dist/",
    "autoReloadExclude": ".*\\.log$|.*agent-debug\\.log$",
    "frontendLibrary": {
      "projectPath": ".",
      "devCommand": "node scripts/dev.mjs",
      "devUrl": "http://localhost:5173",
      "buildCommand": "bun build ./server/index.ts --compile  --outfile /dist/crabclaw/crabclaw-server",
      "patchFile": "/frontend/index.html",
      "waitTimeout": 30000
    }
  },
  "nativeAllowList": [
    "window.*",
    "app.*",
    "clipboard.*",
    "os.*",
    "filesystem.*"
  ],
  "modes": {
    "window": {
      "title": "crabclaw",
      "width": 1480,
      "height": 980,
      "minWidth": 1180,
      "minHeight": 760,
      "resizable": true,
      "maximize": false,
      "enableInspector": true,
      "injectClientLibrary": false,
      "useSavedState": true,
      "icon": "/icons/appIcon.png"
    }
  }
}
